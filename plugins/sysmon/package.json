{
  "name": "@accsci/dsh-sysmon",
  "version": "1.0.0",
  "description": "Live CPU, memory and GPU readout under the DSH composer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-monitor",
    "cpu",
    "gpu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACCSCI/dsh-plugins.git",
    "directory": "plugins/sysmon"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
