{
  "name": "@accsci/dsh-auto-retry",
  "version": "1.0.0",
  "description": "Retry transient provider failures until they succeed, from a GUI switch that never retries quota or credential errors.",
  "market": {
    "title": { "en": "Auto retry", "zh": "自动重试" },
    "description": {
      "zh": "供应商临时故障（超时、断流、限流、5xx）时把模型请求重试到成功；额度、鉴权、请求非法则立即失败。开关在设置与会话头药丸，两处同步。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "retry",
    "provider",
    "timeout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACCSCI/dsh-plugins.git",
    "directory": "plugins/auto-retry"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
