{
  "name": "@dsh-external/workspace-todo",
  "version": "0.1.0",
  "description": "工作区待办清单：会话顶栏按钮 + 浮层面板，按工作目录把清单存在 <项目>/.dsh/todos.json",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
