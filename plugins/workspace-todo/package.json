{
  "name": "@accsci/dsh-workspace-todo",
  "version": "0.1.0",
  "description": "A todo list bound to the Session's working directory, opened from the Session header.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACCSCI/dsh-plugins.git",
    "directory": "plugins/workspace-todo"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
