{
  "name": "@accsci/dsh-workspace-todo",
  "version": "0.1.0",
  "description": "A todo list bound to the Session's working directory, opened from the Session header.",
  "market": {
    "title": { "en": "Workspace todo", "zh": "工作区待办" },
    "description": {
      "zh": "绑定到当前会话工作目录的待办清单：会话顶栏一个按钮打开浮层面板；数据存在 <工作目录>/.dsh/todos.json，同一目录下的所有会话共享一份。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACCSCI/dsh-plugins.git",
    "directory": "plugins/workspace-todo"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./icon": {
      "default": "./icon.svg"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
